<?xml version="1.0" encoding="utf-8"?>
<!-- Restore packages only from nuget.org, whatever other feeds are set up on the developer's machine. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
