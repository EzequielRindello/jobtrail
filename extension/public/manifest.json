{
  "manifest_version": 3,
  "name": "JobTrail",
  "version": "0.2.0",
  "description": "Save the job post you are looking at to your JobTrail board in one click.",
  "action": {
    "default_title": "Save to JobTrail",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:5080/*"]
}
